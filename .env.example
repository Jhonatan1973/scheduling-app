# Copy to .env and adjust. NEVER commit the real .env file.

# PostgreSQL password used by docker-compose
POSTGRES_PASSWORD=postgres

# JWT signing key: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Seed demo professionals/client on first start (true/false)
SEED_DEMO_DATA=true

# ---- Production only (Render / Railway env vars) ----
# ConnectionStrings__Database=postgresql://user:password@host:5432/dbname
# Jwt__Secret=...
# Email__Provider=Brevo            # Log | Smtp | Brevo
# Email__FromEmail=you@yourdomain.com
# Email__Brevo__ApiKey=...
# Notifications__PublicWebUrl=https://your-web.onrender.com
# Api__BaseUrl=https://your-api.onrender.com/   (Web service)
