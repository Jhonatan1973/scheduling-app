@page "/login"
@inject ApiClient Api
@inject AppAuthStateProvider Auth
@inject NavigationManager Navigation
@inject IOptions<WebOptions> Options

<PageTitle>Sign in · Scheduling App</PageTitle>

<div class="auth-layout">
    <div class="card auth-card">
        <h1>Welcome back</h1>
        <p class="muted">Sign in to book or manage appointments.</p>

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <label class="field">
                <span>Email</span>
                <input type="email" autocomplete="email" required @bind="_email" data-testid="login-email" />
            </label>
            <label class="field">
                <span>Password</span>
                <input type="password" autocomplete="current-password" required @bind="_password" data-testid="login-password" />
            </label>

            <ErrorAlert Message="@_error" />

            <button class="btn btn-primary btn-block" type="submit" disabled="@_busy" data-testid="login-submit">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </form>

        <p class="muted center">No account yet? <a href="/register">Create one</a></p>
    </div>

    @if (Options.Value.ShowDemoAccounts)
    {
        <aside class="card demo-card">
            <h3>Try the demo</h3>
            <p class="muted">Password for all demo accounts: <code>Demo@12345</code></p>
            <button class="demo-account" @onclick='() => Fill("client@demo.com")'>
                <strong>Client</strong><span>client@demo.com</span>
            </button>
            <button class="demo-account" @onclick='() => Fill("sofia@demo.com")'>
                <strong>Professional · Dermatologist</strong><span>sofia@demo.com</span>
            </button>
            <button class="demo-account" @onclick='() => Fill("lucas@demo.com")'>
                <strong>Professional · Barber</strong><span>lucas@demo.com</span>
            </button>
        </aside>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    private void Fill(string email)
    {
        _email = email;
        _password = "Demo@12345";
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.LoginAsync(new LoginRequest(_email, _password));
        if (!result.IsSuccess)
        {
            _error = result.Error;
            _busy = false;
            return;
        }

        await Auth.SignInAsync(result.Value!);
        Navigation.NavigateTo(SafeReturnUrl() ?? (result.Value!.User.Role == UserRole.Professional ? "/pro/schedule" : "/"));
    }

    private string? SafeReturnUrl() =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : null;
}
