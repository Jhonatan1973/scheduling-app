@page "/appointments"
@using SchedulingApp.Application.Dtos
@using SchedulingApp.Domain.Enums
@inject SchedulingApiClient Api
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>My appointments</PageTitle>

<h1>@(Session.IsAdmin ? "Professional schedule" : "My appointments")</h1>

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-warning">Please <a href="login">sign in</a>.</div>
}
else if (_loading)
{
    <p>Loading...</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>When (local)</th>
                    <th>Professional</th>
                    <th>Client</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _appointments)
                {
                    <tr>
                        <td>@item.StartUtc.ToLocalTime().ToString("g")</td>
                        <td>@item.ProfessionalName</td>
                        <td>@item.ClientName</td>
                        <td><span class="badge text-bg-secondary">@item.Status</span></td>
                        <td>
                            @if (item.Status != AppointmentStatus.Cancelled && item.StartUtc > DateTime.UtcNow)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(item.Id)">Cancel</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private List<AppointmentDto> _appointments = [];

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            _appointments = (await Api.GetMyAppointmentsAsync()).ToList();
        }

        _loading = false;
    }

    private async Task CancelAsync(Guid id)
    {
        if (await Api.CancelAppointmentAsync(id))
        {
            _appointments = (await Api.GetMyAppointmentsAsync()).ToList();
        }
    }
}
