@page "/"
@inject ApiClient Api

<PageTitle>Scheduling App · Book with professionals</PageTitle>

<section class="hero">
    <div>
        <span class="eyebrow">Barbers · Clinics · Tutors</span>
        <h1>Book your next appointment in seconds.</h1>
        <p class="lead">
            Pick a professional, choose a free time slot and get an email as soon as it is confirmed.
            Professionals manage their weekly hours and daily agenda in one place.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="#professionals">Find a professional</a>
            <a class="btn btn-ghost" href="/register?role=Professional">I'm a professional</a>
        </div>
    </div>
    <ul class="hero-steps">
        <li><span>1</span> Choose a professional</li>
        <li><span>2</span> Pick a free slot</li>
        <li><span>3</span> Get confirmed by email</li>
    </ul>
</section>

<section id="professionals" class="section">
    <div class="section-head">
        <h2>Professionals</h2>
        <form class="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <input type="search" placeholder="Search by name or specialty…" @bind="_search" @bind:event="oninput" aria-label="Search professionals" />
            <button class="btn btn-ghost" type="submit">Search</button>
        </form>
    </div>

    <ErrorAlert Message="@_error" />

    @if (_professionals is null)
    {
        <Loading Text="Loading professionals…" />
    }
    else if (_professionals.Count == 0)
    {
        <div class="empty-state">
            <h3>No professionals found</h3>
            <p>Try another search term.</p>
        </div>
    }
    else
    {
        <div class="grid cards">
            @foreach (var pro in _professionals)
            {
                <a class="card pro-card" href="/professionals/@pro.Id" data-testid="professional-card">
                    <div class="avatar avatar-lg">@pro.DisplayName[0]</div>
                    <div class="pro-card-body">
                        <h3>@pro.DisplayName</h3>
                        <span class="pill">@pro.Specialty</span>
                        @if (!string.IsNullOrWhiteSpace(pro.Bio))
                        {
                            <p class="muted clamp">@pro.Bio</p>
                        }
                        <span class="meta">@pro.SlotDurationMinutes min sessions · @TimeZones.Friendly(pro.TimeZoneId)</span>
                    </div>
                    <span class="card-cta">See availability →</span>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<ProfessionalDto>? _professionals;
    private string? _search;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        var result = await Api.GetProfessionalsAsync(_search);
        _professionals = result.Value ?? [];
        _error = result.Error;
    }
}
