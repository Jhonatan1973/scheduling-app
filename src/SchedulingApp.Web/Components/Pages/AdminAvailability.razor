@page "/admin/availability"
@using SchedulingApp.Application.Dtos
@inject SchedulingApiClient Api
@inject AuthSession Session

<PageTitle>Manage availability</PageTitle>

<h1>Weekly availability</h1>

@if (!Session.IsAdmin)
{
    <div class="alert alert-warning">Admin access required.</div>
}
else if (_professional is null)
{
    <p>Loading professional profile...</p>
}
else
{
    <p class="text-secondary">Managing schedule for <strong>@_professional.DisplayName</strong>.</p>

    <EditForm Model="_form" OnValidSubmit="SaveRuleAsync" class="row g-2 col-lg-8 mb-4">
        <div class="col-md-4">
            <InputSelect @bind-Value="_form.DayOfWeek" class="form-select">
                @foreach (var day in Enum.GetValues<DayOfWeek>())
                {
                    <option value="@day">@day</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-3">
            <InputText @bind-Value="_startTime" class="form-control" placeholder="09:00" />
        </div>
        <div class="col-md-3">
            <InputText @bind-Value="_endTime" class="form-control" placeholder="17:00" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" disabled="@_busy">Save</button>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <ul class="list-group col-lg-8">
        @foreach (var rule in _rules)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@rule.DayOfWeek: @rule.StartTime.ToString("HH\\:mm") - @rule.EndTime.ToString("HH\\:mm")</span>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRuleAsync(rule.Id)">Remove</button>
            </li>
        }
    </ul>
}

@code {
    private ProfessionalDto? _professional;
    private List<AvailabilityRuleDto> _rules = [];
    private UpsertAvailabilityRuleRequest _form = new(DayOfWeek.Monday, new TimeOnly(9, 0), new TimeOnly(17, 0));
    private string _startTime = "09:00";
    private string _endTime = "17:00";
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAdmin)
        {
            return;
        }

        _professional = await Api.GetMyProfessionalAsync();
        if (_professional is not null)
        {
            await ReloadRulesAsync();
        }
    }

    private async Task ReloadRulesAsync()
    {
        if (_professional is null)
        {
            return;
        }

        _rules = (await Api.GetAvailabilityRulesAsync(_professional.Id)).ToList();
    }

    private async Task SaveRuleAsync()
    {
        if (!TimeOnly.TryParse(_startTime, out var start) || !TimeOnly.TryParse(_endTime, out var end))
        {
            _message = "Use HH:mm time format.";
            return;
        }

        _busy = true;
        _message = null;
        _form = _form with { StartTime = start, EndTime = end };

        if (await Api.UpsertAvailabilityRuleAsync(_form))
        {
            await ReloadRulesAsync();
            _message = "Availability saved.";
        }
        else
        {
            _message = "Could not save availability.";
        }

        _busy = false;
    }

    private async Task DeleteRuleAsync(Guid ruleId)
    {
        if (await Api.DeleteAvailabilityRuleAsync(ruleId))
        {
            await ReloadRulesAsync();
        }
    }
}
